{
  "site_name": "hebei_cangzhou_gov_leadership",
  "start_urls": [
    "https://www.cangzhou.gov.cn/cangzhou/c116519e/202311/c8a74143818f4147be693259ed8a68a4.shtml"
  ],
  "allowed_domains": [
    "www.cangzhou.gov.cn",
    "cangzhou.gov.cn"
  ],
  "user_agent": "D2ILiteArchiveBot/1.0 (+local archival use)",
  "default_headers": {
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Referer": "https://www.cangzhou.gov.cn/"
  },
  "image_headers": {
    "Referer": "https://www.cangzhou.gov.cn/"
  },
  "output_root": "data/public_archive",
  "selectors": {
    "list_item": "xpath://a[contains(@href,'.shtml') and (contains(normalize-space(.),'副市长') or contains(normalize-space(.),'市长') or contains(@href,'c1165') or contains(@href,'add1013'))]",
    "name": [
      "xpath:normalize-space(string(.))"
    ],
    "detail_link": [
      "xpath:./@href"
    ],
    "list_fields": {},
    "next_page": [],
    "detail_name": [
      "xpath:normalize-space(string(//div[contains(@class,'avatar')]//p[1]))",
      "xpath:normalize-space(//div[contains(@class,'avatar')]//p[1]//text())",
      "xpath:normalize-space(string(//div[contains(@class,'right')]//p[contains(@style,'text-indent')][1]))"
    ],
    "detail_image": [
      "xpath://div[contains(@class,'avatar')]//img/@src",
      "xpath://img[contains(@src,'/images/') and (contains(@src,'.jpg') or contains(@src,'.png') or contains(@src,'.jpeg'))]/@src"
    ],
    "detail_gender": [],
    "detail_summary": [
      "xpath://div[contains(@class,'centerBox')]//p[string-length(normalize-space())>20][1]",
      "xpath://div[contains(@class,'right')]//p[contains(@style,'text-indent')][1]"
    ],
    "detail_full_text": [
      "xpath://div[contains(@class,'right')]",
      "xpath://div[contains(@class,'centerBox')]"
    ],
    "detail_fields": {},
    "detail_field_labels": {}
  },
  "rules": {
    "obey_robots_txt": false,
    "snapshot_html": true,
    "extract_images": true,
    "write_metadata": true,
    "direct_write_images": true,
    "named_images_dir": "",
    "image_referer_from_detail_url": true,
    "required_fields": [
      "name",
      "detail_url"
    ],
    "default_gender": "",
    "gender_map": {
      "男": "男",
      "女": "女"
    },
    "field_map": {
      "person": ["name"],
      "image_url": ["image_url"],
      "summary": ["summary"],
      "full_content": ["full_content"]
    },
    "auto_unit_subdir": true,
    "unit_name": "沧州市人民政府",
    "output_region": "河北省",
    "output_subdir": "沧州市/市级/{unit}",
    "output_subdir_pattern": "{region}/{output_subdir}",
    "year_hint": "2026",
    "admin": {
      "province": "河北省",
      "city": "沧州市"
    },
    "image_naming": "name",
    "same_name_dedup": true,
    "image_download_mode": "requests_jsl",
    "auto_fallback_to_browser": true,
    "browser_engine": "edge",
    "output_mode": "images_only_with_record",
    "keep_record_file": true,
    "notes": "T0 WP-F Hebei Cangzhou; prefer scripts/t0_cangzhou_leadership_collect.py for registry writeback. Final land: /vol1/1001/角色肖像/政府/河北省/..."
  },
  "crawl": {
    "speed_tier": "safe",
    "speed_tier_reason": "政府领导页，默认安全档",
    "concurrent_requests": 1,
    "download_delay": 5,
    "autothrottle_start_delay": 5,
    "autothrottle_max_delay": 10,
    "retry_times": 3,
    "timeout_seconds": 30,
    "blocked_statuses": [403, 429],
    "blocked_backoff_hours": 6,
    "suspect_block_consecutive_failures": 3,
    "interval_min_seconds": 5,
    "interval_max_seconds": 8,
    "image_interval_min_seconds": 5,
    "image_interval_max_seconds": 8
  }
}
